# Airwave Configuration
#
# Copy this file to .env before starting the station:
#   cp .env.example .env
# The copy is required under docker-compose (the app bind-mounts ./.env so
# API keys entered through the setup wizard persist across restarts).

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# Under docker-compose this is overridden to sqlite+aiosqlite:////data/radio.db
# so the database persists on the named "radio-data" volume.
DATABASE_URL=sqlite+aiosqlite:///./radio.db

# Audio
AUDIO_DIR=./audio

# Google AI API key - powers DJ scripts and talk segments
GOOGLE_API_KEY=
# Gemini model used for script writing
GEMINI_MODEL=gemini-3.6-flash

# SunoAPI.org — music generation
SUNO_API_KEY=
SUNO_MODEL=V5_5

# Fish Audio - TTS voice provider
FISH_AUDIO_API_KEY=
# TTS model: s2.1-pro (recommended), s2.1-pro-free, s2-pro, or s1
FISH_AUDIO_MODEL=s2.1-pro

# Liquidsoap (telnet connection)
LIQUIDSOAP_HOST=liquidsoap
LIQUIDSOAP_PORT=1234
# Harbor input port for live caller audio (compose-network only, never published)
LIQUIDSOAP_HARBOR_PORT=8005
# Password a source must present to connect to the liquidsoap harbor input.
# CHANGE THIS before running on a shared network.
HARBOR_SOURCE_PASSWORD=hackme

# Icecast
# Public stream URL shown to listeners and the dashboard player
ICECAST_URL=http://localhost:8080/stream
# Passwords injected into the Icecast container and used by Liquidsoap to
# connect. CHANGE THESE before exposing the station beyond localhost.
ICECAST_SOURCE_PASSWORD=hackme
ICECAST_ADMIN_PASSWORD=hackme

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000
