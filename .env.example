# AI Radio DJ Configuration

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./radio.db

# Audio
AUDIO_DIR=./audio

# Google AI API key - powers DJ scripts and talk segments
GOOGLE_API_KEY=

# SunoAPI.org — music generation (preferred over Lyria when set)
SUNO_API_KEY=
SUNO_MODEL=V5_5

# Fish Audio - TTS voice provider
FISH_AUDIO_API_KEY=

# Twilio (listener call-in)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
CALL_WEBHOOK_BASE_URL=
CALL_HASH_SECRET=change-me-to-a-random-secret

# Liquidsoap (telnet connection)
LIQUIDSOAP_HOST=liquidsoap
LIQUIDSOAP_PORT=1234

# Icecast
ICECAST_URL=http://localhost:8080/stream
ICECAST_SOURCE_PASSWORD=hackme
ICECAST_ADMIN_PASSWORD=hackme
ICECAST_HOSTNAME=localhost
ICECAST_PORT=8080
